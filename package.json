{
  "name": "frontdesk-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FrontDesk AI: a voice receptionist for clinics (Vapi, Retell or Bland) that answers FAQs, books, reschedules and cancels appointments, and captures leads.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup:vapi": "node vapi/setupAssistant.js",
    "setup:vapi:clinic": "node vapi/setupAssistant.js clinic",
    "setup:vapi:real-estate": "node vapi/setupAssistant.js real-estate",
    "setup:vapi:general": "node vapi/setupAssistant.js general-business",
    "setup:vapi:all": "node vapi/setupAssistant.js all",
    "setup:agent": "node retell/setupAgent.js",
    "setup:retell:clinic": "node retell/setupAgent.js clinic",
    "setup:retell:real-estate": "node retell/setupAgent.js real-estate",
    "setup:retell:general": "node retell/setupAgent.js general-business",
    "setup:retell:all": "node retell/setupAgent.js all",
    "setup:bland-agent": "node bland/setupAgent.js",
    "seed:kb": "node kb/seed.js",
    "switch:phone": "node scripts/switchPhone.js",
    "setup:hubspot": "node scripts/setupHubspotProperties.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.11.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "openai": "^4.67.3",
    "twilio": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
