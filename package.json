  "dependencies": {
    "@qdrant/js-client-rest": "^1.11.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "openai": "^4.67.3",
    "twilio": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
