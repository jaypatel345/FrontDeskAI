{
  "name": "ai-clinic-receptionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retell-powered AI receptionist for a cosmetic clinic: booking, FAQs, lead qualification.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup:vapi": "node vapi/setupAssistant.js",
