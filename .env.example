# --- Server ---
PORT=3000
# Public URL Retell can reach (ngrok URL locally, real domain in prod).
BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- Retell ---
RETELL_API_KEY=
# Copy a voice_id from the Retell dashboard > Voices (pick an ElevenLabs Flash v2.5
# or Cartesia Sonic voice for the best latency/naturalness tradeoff).
RETELL_VOICE_ID=
RETELL_LLM_MODEL=claude-4.5-haiku
RETELL_AGENT_NAME=Clinic Receptionist

# --- Bland (backup platform, in case Retell verification takes too long) ---
BLAND_API_KEY=
# Copy a voice id from `GET https://api.bland.ai/v1/voices` or the Bland dashboard.
BLAND_VOICE_ID=
# Set once you've purchased/assigned an inbound number in Bland; leave blank to only
# generate the config for an outbound test call instead.
BLAND_PHONE_NUMBER=

# --- Redis (availability cache, session state) ---
REDIS_URL=redis://localhost:6379

# --- Qdrant (RAG knowledge base). Use a Qdrant Cloud cluster URL (cloud.qdrant.io) instead of
# localhost - the local Docker instance was unstable in dev testing.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clinic_kb
# Optional. Without this, RAG falls back to local keyword search over kb/clinicKnowledgeBase.json
# so you can still test end-to-end with zero paid API keys.
OPENAI_API_KEY=

# --- Scheduling: Cal.com (default). Swap services/scheduling.js for the clinic's real PMS
# (Boulevard, Zenoti, Mindbody, Vagaro, etc.) later — same adapter interface.
# Without these, scheduling falls back to mock in-memory slots so you can test the full flow.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# --- CRM: HubSpot (default). Without this, leads/bookings are just logged to SQLite + console.
HUBSPOT_API_KEY=

# --- SMS confirmations (Twilio). Without these, SMS sends are logged to console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Front-desk number the agent transfers to on escalation / complex medical questions.
HUMAN_TRANSFER_NUMBER=+15555550100

CLINIC_TIMEZONE=America/Los_Angeles
DB_PATH=./data/clinic.db
