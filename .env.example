# --- Server ---
PORT=3000
# Public URL Retell can reach (ngrok URL locally, real domain in prod).
BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Environment. Set to "production" on the deployed server: auth checks then fail closed.
NODE_ENV=development
# Shared secret sent by Retell/Bland as the x-functions-secret header on every tool call.
# Generate one with: openssl rand -hex 32  (then rerun npm run setup:agent)
FUNCTIONS_SECRET=
# Max /functions/* requests per minute per IP. Retell's calls share a few IPs, so keep it generous.
FUNCTIONS_RATE_LIMIT_PER_MINUTE=120
# Login for /dashboard (browser shows a username/password prompt).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Vapi (primary voice platform) ---
# Dashboard > Organization > API Keys. The private key creates/updates the assistant
# (npm run setup:vapi); the public key is only for a browser "talk to it" widget.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_NAME=Clinic Receptionist
# LLM and voice used on calls. Defaults are covered by Vapi's free signup credit.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Savannah

# --- Retell (original platform; kept working, account currently on hold) ---
RETELL_API_KEY=
# Copy a voice_id from the Retell dashboard > Voices (pick an ElevenLabs Flash v2.5
# or Cartesia Sonic voice for the best latency/naturalness tradeoff).
RETELL_VOICE_ID=
RETELL_LLM_MODEL=claude-4.5-haiku
RETELL_AGENT_NAME=Clinic Receptionist

# --- Bland (backup platform, in case Retell verification takes too long) ---
BLAND_API_KEY=
# Copy a voice id from `GET https://api.bland.ai/v1/voices` or the Bland dashboard.
BLAND_VOICE_ID=
# Set once you've purchased/assigned an inbound number in Bland; leave blank to only
# generate the config for an outbound test call instead.
BLAND_PHONE_NUMBER=

# --- Redis (availability cache, session state) ---
REDIS_URL=redis://localhost:6379
# (Optional - leave blank to cache in memory only, e.g. on a single-instance host.)

# --- Qdrant (RAG knowledge base). Use a Qdrant Cloud cluster URL (cloud.qdrant.io) instead of
# localhost - the local Docker instance was unstable in dev testing.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clinic_kb
# Optional. Without this, RAG falls back to local keyword search over kb/clinicKnowledgeBase.json
# so you can still test end-to-end with zero paid API keys.
OPENAI_API_KEY=

# --- Scheduling: Cal.com (default). Swap services/scheduling.js for the clinic's real PMS
# (Boulevard, Zenoti, Mindbody, Vagaro, etc.) later — same adapter interface.
# Without these, scheduling falls back to mock in-memory slots so you can test the full flow.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# --- CRM: HubSpot (default). Without this, leads/bookings are just logged to SQLite + console.
HUBSPOT_API_KEY=

# --- SMS confirmations (Twilio). Without these, SMS sends are logged to console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Front-desk number the agent transfers to on escalation / complex medical questions.
HUMAN_TRANSFER_NUMBER=+15555550100

CLINIC_TIMEZONE=America/Los_Angeles
# Spoken by the agent and used in SMS. A name starting with "Demo" tells the agent to admit the
# clinic is fictional if asked; set the real name for a real deployment.
CLINIC_NAME=Demo Aesthetics Clinic
CLINIC_LOCATION=Los Angeles, California
DB_PATH=./data/clinic.db
